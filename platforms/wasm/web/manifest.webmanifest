{
  "name": "CrabBoy",
  "short_name": "CrabBoy",
  "description": "Game Boy, Game Boy Color and Game Boy Advance emulator in Rust, running in the browser",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#1b1b1f",
  "theme_color": "#1b1b1f",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ]
}
